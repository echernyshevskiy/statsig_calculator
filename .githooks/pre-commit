#!/bin/sh

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "Commit blocked: gitleaks is not installed or is not available in PATH." >&2
  echo "Install it from https://github.com/gitleaks/gitleaks and retry." >&2
  exit 1
fi

exec gitleaks git --pre-commit --staged --redact --no-banner --no-color
